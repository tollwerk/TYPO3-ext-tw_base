<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="es" datatype="plaintext" original="EXT:tw_base/Configuration/Sets/TwBase/labels.xlf" product-name="tw_base">
        <header/>
        <body>
            <trans-unit id="label" resname="label">
                <source>Basics</source>
                <target state="translated">Fundamentos</target>
            </trans-unit>
            <trans-unit id="categories.twBase.mail" resname="categories.twBase.mail">
                <source>Mails</source>
                <target state="translated">Correos electrónicos</target>
            </trans-unit>
            <trans-unit id="categories.twBase.mail.tokens" resname="categories.twBase.mail.tokens">
                <source>Design</source>
                <target state="translated">Diseño</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.sender" resname="settings.twBase.mail.sender">
                <source>Sender</source>
                <target state="translated">Remitente</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.sender" resname="settings.description.twBase.mail.sender">
                <source>Who sends the mails, such as the name and address of the organisation, for the footer of every mail; empty for the title of the website</source>
                <target state="translated">Quién envía los correos, por ejemplo el nombre y la dirección de la organización, para el pie de cada correo; vacío para el título del sitio web</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.contact" resname="settings.twBase.mail.contact">
                <source>Contact address</source>
                <target state="translated">Dirección de contacto</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.contact" resname="settings.description.twBase.mail.contact">
                <source>Email address for questions, linked in the footer of every mail and the address replies go to</source>
                <target state="translated">Dirección de correo para preguntas, enlazada en el pie de cada correo y a la que llegan las respuestas</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.imprint" resname="settings.twBase.mail.imprint">
                <source>Legal notice</source>
                <target state="translated">Aviso legal</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.imprint" resname="settings.description.twBase.mail.imprint">
                <source>Page with the legal notice, linked in the footer of every mail</source>
                <target state="translated">Página con el aviso legal, enlazada en el pie de cada correo</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.stylesheet" resname="settings.twBase.mail.stylesheet">
                <source>Stylesheet</source>
                <target state="translated">Hoja de estilos</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.stylesheet" resname="settings.description.twBase.mail.stylesheet">
                <source>Additional stylesheet for mails, such as EXT:my_site/Resources/Private/Mail.css, whose rules follow those of the components; it may use the tokens as custom properties</source>
                <target state="translated">Hoja de estilos adicional para los correos, por ejemplo EXT:my_site/Resources/Private/Mail.css, cuyas reglas siguen a las de los componentes; puede usar los tokens como propiedades personalizadas</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.color.text" resname="settings.twBase.mail.tokens.color.text">
                <source>Text</source>
                <target state="translated">Texto</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.color.background" resname="settings.twBase.mail.tokens.color.background">
                <source>Background</source>
                <target state="translated">Fondo</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.color.muted" resname="settings.twBase.mail.tokens.color.muted">
                <source>Muted text</source>
                <target state="translated">Texto atenuado</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.tokens.color.muted" resname="settings.description.twBase.mail.tokens.color.muted">
                <source>Text of the website name and the footer</source>
                <target state="translated">Texto del nombre del sitio web y del pie</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.color.accent" resname="settings.twBase.mail.tokens.color.accent">
                <source>Accent</source>
                <target state="translated">Acento</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.tokens.color.accent" resname="settings.description.twBase.mail.tokens.color.accent">
                <source>Links, buttons and the border of notices</source>
                <target state="translated">Enlaces, botones y el borde de los avisos</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.color.accentText" resname="settings.twBase.mail.tokens.color.accentText">
                <source>Text on the accent</source>
                <target state="translated">Texto sobre el acento</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.tokens.color.accentText" resname="settings.description.twBase.mail.tokens.color.accentText">
                <source>Text of buttons</source>
                <target state="translated">Texto de los botones</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.color.border" resname="settings.twBase.mail.tokens.color.border">
                <source>Border</source>
                <target state="translated">Borde</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.tokens.color.border" resname="settings.description.twBase.mail.tokens.color.border">
                <source>Line above the footer</source>
                <target state="translated">Línea sobre el pie</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.dark.color.text" resname="settings.twBase.mail.tokens.dark.color.text">
                <source>Text in dark mode</source>
                <target state="translated">Texto en modo oscuro</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.dark.color.background" resname="settings.twBase.mail.tokens.dark.color.background">
                <source>Background in dark mode</source>
                <target state="translated">Fondo en modo oscuro</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.dark.color.muted" resname="settings.twBase.mail.tokens.dark.color.muted">
                <source>Muted text in dark mode</source>
                <target state="translated">Texto atenuado en modo oscuro</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.dark.color.accent" resname="settings.twBase.mail.tokens.dark.color.accent">
                <source>Accent in dark mode</source>
                <target state="translated">Acento en modo oscuro</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.dark.color.accentText" resname="settings.twBase.mail.tokens.dark.color.accentText">
                <source>Text on the accent in dark mode</source>
                <target state="translated">Texto sobre el acento en modo oscuro</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.dark.color.border" resname="settings.twBase.mail.tokens.dark.color.border">
                <source>Border in dark mode</source>
                <target state="translated">Borde en modo oscuro</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.font.family" resname="settings.twBase.mail.tokens.font.family">
                <source>Font</source>
                <target state="translated">Fuente</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.tokens.font.family" resname="settings.description.twBase.mail.tokens.font.family">
                <source>Font stack of the text</source>
                <target state="translated">Lista de fuentes del texto</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.font.code" resname="settings.twBase.mail.tokens.font.code">
                <source>Font of codes</source>
                <target state="translated">Fuente de los códigos</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.tokens.font.code" resname="settings.description.twBase.mail.tokens.font.code">
                <source>Font stack of codes</source>
                <target state="translated">Lista de fuentes de los códigos</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.font.size" resname="settings.twBase.mail.tokens.font.size">
                <source>Font size</source>
                <target state="translated">Tamaño de fuente</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.tokens.font.size" resname="settings.description.twBase.mail.tokens.font.size">
                <source>Size of the text, at least 16px</source>
                <target state="translated">Tamaño del texto, al menos 16px</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.tokens.width" resname="settings.twBase.mail.tokens.width">
                <source>Width</source>
                <target state="translated">Ancho</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.tokens.width" resname="settings.description.twBase.mail.tokens.width">
                <source>Largest width of the content</source>
                <target state="translated">Ancho máximo del contenido</target>
            </trans-unit>
        </body>
