                <source>Design</source>
                <target state="translated">Apparence</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.sender" resname="settings.twBase.mail.sender">
                <source>Sender</source>
                <target state="translated">Expéditeur</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.sender" resname="settings.description.twBase.mail.sender">
                <source>Who sends the mails, such as the name and address of the organisation, for the footer of every mail; empty for the title of the website</source>
                <target state="translated">Qui envoie les e-mails, par exemple le nom et l’adresse de l’organisation, pour le pied de chaque e-mail ; vide pour le titre du site web</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.contact" resname="settings.twBase.mail.contact">
                <source>Contact address</source>
                <target state="translated">Adresse de contact</target>
            </trans-unit>
            <trans-unit id="settings.description.twBase.mail.contact" resname="settings.description.twBase.mail.contact">
                <source>Email address for questions, linked in the footer of every mail and the address replies go to</source>
                <target state="translated">Adresse e-mail pour les questions, liée dans le pied de chaque e-mail, qui reçoit aussi les réponses</target>
            </trans-unit>
            <trans-unit id="settings.twBase.mail.imprint" resname="settings.twBase.mail.imprint">
