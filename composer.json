{
    "name": "tollwerk/tw-base",
    "description": "Headings, structured data, responsive images, link information, file attribution, components and accessible mails for TYPO3",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "require": {
        "php": "^8.5",
        "tijsverkoyen/css-to-inline-styles": "^2.4",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-filemetadata": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "saschaegerer/phpstan-typo3": "*",
        "ssch/typo3-rector": "*",
        "tollwerk/guidelines": "dev-main",
        "typo3/testing-framework": "^9.7"
    },
    "repositories": [
        {
            "name": "tollwerk-guidelines",
            "type": "vcs",
            "url": "git@code.tollwerk.net:tollwerk/guidelines.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tollwerk\\TwBase\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tollwerk\\TwBaseComponents\\": "tests/Functional/Fixtures/Extensions/tw_base_components/Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "platform": {
            "php": "8.5.0"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "14.x-dev"
        },
        "typo3/cms": {
            "extension-key": "tw_base"
        }
    },
    "scripts": {
        "post-install-cmd": "test ! -x vendor/bin/guidelines || vendor/bin/guidelines install",
        "post-update-cmd": "test ! -x vendor/bin/guidelines || vendor/bin/guidelines install",
        "check": "guidelines gate",
        "fix": "guidelines fix"
    }
}
